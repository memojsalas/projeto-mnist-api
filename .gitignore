# ============================================================
# .gitignore — Projeto MNIST Classifier API
# ============================================================

# ---------- Ambientes virtuais ----------
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ---------- Jupyter / Notebooks ----------
.ipynb_checkpoints/
*.ipynb_checkpoints
notebooks/.ipynb_checkpoints/

# ---------- IDEs ----------
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ---------- Sistema operacional ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------- Variáveis de ambiente ----------
.env
.env.local
.env.*.local
!.env.example

# ---------- Logs ----------
*.log
logs/
pip-log.txt
pip-delete-this-directory.txt

# ---------- Dados grandes (opcional) ----------
# Descomente se NÃO quiser versionar dados brutos
# data/*.npy
# data/*.npz
# data/*.csv
# data/*.zip
# data/*.gz

# ---------- Modelos grandes (opcional) ----------
# Descomente se NÃO quiser versionar modelos treinados
# (recomendado apenas para repos muito grandes)
# models/*.keras
# models/*.h5
# models/*.joblib
# models/*.pkl

# ---------- Docker ----------
# (mantido para versionar Dockerfile e docker-compose)

# ---------- Cobertura de testes ----------
.coverage
coverage.xml
*.cover
.hypothesis/

# ---------- Miscelânea ----------
*.bak
*.tmp
*.temp
*.orig

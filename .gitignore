venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ---------- Jupyter / Notebooks ----------
.ipynb_checkpoints/
*.ipynb_checkpoints
notebooks/.ipynb_checkpoints/

# ---------- IDEs ----------
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ---------- Sistema operacional ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------- Variáveis de ambiente ----------
